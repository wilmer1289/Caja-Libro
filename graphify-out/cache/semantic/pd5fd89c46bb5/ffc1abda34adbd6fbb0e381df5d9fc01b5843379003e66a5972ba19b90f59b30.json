{"nodes": [{"id": "android_app_src_main_res_mipmap_xxxhdpi_ic_launcher", "label": "ic_launcher.png (xxxhdpi, 192px launcher icon)", "file_type": "image", "source_file": "android/app/src/main/res/mipmap-xxxhdpi/ic_launcher.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "android_app_src_main_res_mipmap_xxxhdpi_ic_launcher_app_launcher_icon", "label": "Libro-caja App Launcher Icon (smiling orange semicircle mascot)", "file_type": "concept", "source_file": "android/app/src/main/res/mipmap-xxxhdpi/ic_launcher.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Flat, friendly mascot: a vivid orange half-circle (rising-sun / peeking character) with two dark dot eyes and a small smile, anchored to the bottom edge of a cream/off-white rounded-square tile. Warm, playful branding makes a cash-book (libro caja) finance app feel approachable rather than clinical; the single design is rasterized at five Android densities so it stays crisp on every launcher."}, {"id": "android_app_src_main_res_mipmap_xxxhdpi_ic_launcher_android_mipmap_density_buckets", "label": "Android Mipmap Density Buckets (mdpi/hdpi/xhdpi/xxhdpi/xxxhdpi)", "file_type": "rationale", "source_file": "android/app/src/main/res/mipmap-xxxhdpi/ic_launcher.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Android selects a launcher bitmap from res/mipmap-<density>/ at runtime (1x/1.5x/2x/3x/4x of a 48dp baseline); shipping one ic_launcher per bucket avoids blurry upscaling and wasted downscaling on device home screens."}], "edges": [{"source": "android_app_src_main_res_mipmap_xxxhdpi_ic_launcher", "target": "android_app_src_main_res_mipmap_xxxhdpi_ic_launcher_app_launcher_icon", "relation": "implements", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "android/app/src/main/res/mipmap-xxxhd